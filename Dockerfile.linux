# ==========================================
#   RegulationManager - Linux 构建镜像
#   基于 Ubuntu 20.04（GLIBC 2.31，兼容麒麟 v10 SP1）
# ==========================================
FROM ubuntu:20.04

# 避免交互式提示
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# ── 安装系统依赖 + PyQt5 ──
# 多镜像源轮换，自动重试
RUN for mirror in \
        mirrors.tuna.tsinghua.edu.cn \
        mirrors.ustc.edu.cn \
        mirrors.aliyun.com \
        repo.huaweicloud.com \
        mirrors.cloud.tencent.com \
        archive.ubuntu.com; do \
        echo "Trying mirror: $mirror"; \
        sed -i "s|http://[^/]*/ubuntu|http://$mirror/ubuntu|g" /etc/apt/sources.list; \
        if apt-get update; then break; fi; \
    done \
    && for i in 1 2 3; do \
         DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends --fix-missing \
           python3 python3-pip python3-venv python3-dev \
           python3-pyqt5 python3-pyqt5.qtsvg \
           binutils fcitx-frontend-qt5 git \
           libxcb-xinerama0 libegl1 libxkbcommon0 libgl1 \
         && break || sleep 5; \
       done \
    && rm -rf /var/lib/apt/lists/*

# ── 安装 Python 依赖 ──
# 多镜像源轮换
RUN for mirror in \
        "https://pypi.tuna.tsinghua.edu.cn/simple" \
        "https://mirrors.ustc.edu.cn/pypi/simple" \
        "https://mirrors.aliyun.com/pypi/simple/" \
        "https://repo.huaweicloud.com/repository/pypi/simple" \
        "https://mirrors.cloud.tencent.com/pypi/simple"; do \
        echo "Trying pip mirror: $mirror"; \
        if pip3 install --no-cache-dir --timeout 60 -i "$mirror" \
             SQLAlchemy PyMuPDF python-docx jieba pyinstaller; then \
            break; \
        fi; \
    done

WORKDIR /build
