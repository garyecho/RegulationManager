/* ============================================================
   制度汇编管理系统 — 浅色现代企业级主题（唯一样式入口）
   色板：Primary=#0066CC  Accent=#0078D4  Success=#28A745  Danger=#DC3545
   所有样式集中于此文件，禁止在其他 .py 文件中使用 setStyleSheet()
   ============================================================ */

/* ── 全局 ────────────────────────────────────────────────── */
* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI Variable",
                 "Segoe UI", "SimHei", sans-serif;
    font-size: 16px;
    color: #212529;
}

QMainWindow {
    background-color: #F8F9FA;
}

/* ── 菜单栏 ──────────────────────────────────────────────── */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
    padding: 2px 8px;
}
QMenuBar::item {
    padding: 6px 14px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #E3F2FD;
    color: #0066CC;
}
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    padding: 8px 36px 8px 16px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #E3F2FD;
    color: #0066CC;
}
QMenu::separator {
    height: 1px;
    background-color: #F0F0F0;
    margin: 4px 8px;
}

/* ── 工具栏 ──────────────────────────────────────────────── */
QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
    padding: 6px 12px;
    spacing: 8px;
}
QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 14px;
    color: #212529;
}
QToolBar QToolButton:hover {
    background-color: #E3F2FD;
    color: #0066CC;
}
QToolBar QToolButton:pressed {
    background-color: #C8E6F9;
}

/* ── 侧边栏 ──────────────────────────────────────────────── */
#Sidebar {
    background-color: #13e92f;
    border-right: 1px solid #E0E0E0;
}
#SidebarTitle {
    color: #0066CC;
    font-size: 16px;
    font-weight: bold;
    padding: 20px 16px 6px 16px;
}
#SidebarSubtitle {
    color: #999999;
    font-size: 14px;
    padding: 0px 16px 16px 16px;
}
#Sidebar QPushButton {
    background-color: transparent;
    color: #666666;
    border: none;
    border-left: 4px solid transparent;
    border-radius: 0px;
    padding: 12px 16px;
    text-align: left;
    font-size: 16px;
    min-height: 20px;
}
#Sidebar QPushButton:hover {
    background-color: #F5F7FA;
    color: #212529;
}
#Sidebar QPushButton:checked,
#Sidebar QPushButton[active="true"] {
    background-color: #E3F2FD;
    color: #0066CC;
    border-left: 4px solid #0066CC;
    font-weight: bold;
}
#Sidebar QTreeWidget,
#Sidebar QTreeView {
    background-color: transparent;
    color: #212529;
    border: none;
    outline: none;
    font-size: 16px;
}
#Sidebar QTreeWidget::item,
#Sidebar QTreeView::item {
    padding: 9px 8px;
    border-radius: 6px;
    margin: 1px 4px;
}
#Sidebar QTreeWidget::item:hover,
#Sidebar QTreeView::item:hover {
    background-color: #F5F7FA;
}
#Sidebar QTreeWidget::item:selected,
#Sidebar QTreeView::item:selected {
    background-color: #E3F2FD;
    color: #0066CC;
}
#Sidebar QTreeWidget::branch {
    background-color: transparent;
}
#SidebarSeparator {
    background-color: #F0F0F0;
    max-height: 1px;
}
/* 侧边栏分类标签 */
#SidebarCatLabel {
    color: #0066CC;
    font-size: 16px;
    font-weight: bold;
    padding: 12px 16px 4px 16px;
}
/* 侧边栏统计文字 */
#SidebarStats {
    color: #999999;
    font-size: 14px;
    padding: 12px 16px;
}
/* 侧边栏添加分类按钮 */
#SidebarAddCatBtn {
    background: transparent;
    color: #0066CC;
    border: 1px dashed #E0E0E0;
    border-radius: 8px;
    padding: 8px 16px;
    text-align: center;
    margin: 8px 12px;
}
#SidebarAddCatBtn:hover {
    background-color: #E3F2FD;
}

/* ── 搜索栏 ──────────────────────────────────────────────── */
#SearchBar {
    background-color: #FFFFFF;
    border: 1.5px solid #E0E0E0;
    border-radius: 20px;
    padding: 8px 18px;
    font-size: 13px;
    color: #212529;
}
#SearchBar:focus {
    border-color: #0066CC;
}
#SearchBar::placeholder {
    color: #AAAAAA;
}
/* 搜索栏容器 */
#SearchBarContainer {
    background: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
}

/* ── 面板工具栏 ──────────────────────────────────────────── */
#PanelToolbar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
    padding: 8px;
}
#PanelTitle {
    font-size: 16px;
    font-weight: bold;
    color: #212529;
}
#PanelCount {
    color: #999999;
    font-size: 12px;
    margin-left: 8px;
}
#PanelSortLabel {
    color: #666666;
    font-size: 12px;
}
#PanelSep {
    color: #E0E0E0;
    margin: 0 4px;
}

/* ── 排序按钮 ────────────────────────────────────────────── */
#SortBtnActive {
    background: #E3F2FD;
    color: #0066CC;
    border: 1px solid #B3D9F2;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: bold;
}
#SortBtnInactive {
    background: transparent;
    color: #999999;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
}
#SortBtnInactive:hover {
    background: #F5F7FA;
    color: #212529;
}

/* ── 视图切换按钮 ────────────────────────────────────────── */
#ViewBtnActive {
    background: #0066CC;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 16px;
}
#ViewBtnInactive {
    background: #F8F9FA;
    color: #999999;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    font-size: 16px;
}
#ViewBtnInactive:hover {
    background: #EEF0F2;
    color: #212529;
}

/* ── 批量操作按钮 ────────────────────────────────────────── */
#BatchDeleteBtn {
    background: rgba(220,53,69,0.06);
    color: #DC3545;
    border: 1px solid rgba(220,53,69,0.15);
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: bold;
}
#BatchDeleteBtn:hover {
    background: rgba(220,53,69,0.12);
}
#BatchRestoreBtn {
    background: rgba(40,167,69,0.06);
    color: #28A745;
    border: 1px solid rgba(40,167,69,0.15);
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: bold;
}
#BatchRestoreBtn:hover {
    background: rgba(40,167,69,0.12);
}
#BatchPermanentBtn {
    background: #DC3545;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 4px 14px;
    font-size: 12px;
    font-weight: bold;
}
#BatchPermanentBtn:hover {
    background: #C82333;
}

/* ── 选中计数 ────────────────────────────────────────────── */
#SelectedCount {
    color: #0066CC;
    font-size: 12px;
    font-weight: bold;
}

/* ── 单删按钮 ────────────────────────────────────────────── */
#DeleteBtn {
    background: transparent;
    color: #DC3545;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
}
#DeleteBtn:hover {
    background: rgba(220,53,69,0.06);
    border-color: #DC3545;
}

/* ── 全选栏 ──────────────────────────────────────────────── */
#SelectAllBar {
    background: #F8F9FA;
    border-bottom: 1px solid #E0E0E0;
}
#SelectAllCheckbox {
    font-size: 12px;
    color: #666666;
}

/* ── 分页 ────────────────────────────────────────────────── */
#PageBtn {
    background: #FFFFFF;
    color: #666666;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    padding: 4px 14px;
    font-size: 12px;
}
#PageBtn:hover {
    background: #F5F7FA;
}
#PageLabel {
    color: #999999;
    font-size: 12px;
}

/* ── 表格 ────────────────────────────────────────────────── */
QTableWidget, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    gridline-color: #F0F0F0;
    selection-background-color: #E3F2FD;
    selection-color: #0066CC;
    font-size: 16px;
    outline: none;
}
QTableWidget::item, QTableView::item {
    padding: 6px 12px;
    border-bottom: 1px solid #F0F0F0;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: #E3F2FD;
    color: #0066CC;
}
QHeaderView::section {
    background-color: #FAFBFC;
    color: #666666;
    font-weight: bold;
    font-size: 14px;
    border: none;
    border-bottom: 2px solid #E0E0E0;
    border-right: 1px solid #F0F0F0;
    padding: 10px 12px;
}
QHeaderView::section:hover {
    background-color: #F0F4F8;
    color: #0066CC;
}
/* 表格内复选框 */
QTableWidget QCheckBox {
    spacing: 0px;
}
QTableWidget QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

/* ── 编辑按钮（表格内）─────────────────────────────────────── */
#TableEditBtn {
    background: rgba(0,102,204,0.06);
    color: #0066CC;
    border: 1px solid rgba(0,102,204,0.15);
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 12px;
}
#TableEditBtn:hover {
    background: rgba(0,102,204,0.12);
}

/* ── 按钮 ────────────────────────────────────────────────── */
QPushButton {
    background-color: #0066CC;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #0052A3;
}
QPushButton:pressed {
    background-color: #003D7A;
}
QPushButton:disabled {
    background-color: #CCCCCC;
    color: #888888;
}

/* ── 次要按钮 ────────────────────────────────────────────── */
#DialogBtnSecondary {
    background-color: #F8F9FA;
    color: #212529;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: normal;
}
#DialogBtnSecondary:hover {
    background-color: #EEF0F2;
    border-color: #CCCCCC;
}

/* ── 输入框 ──────────────────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1.5px solid #E0E0E0;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    color: #212529;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #0066CC;
}

/* ── 下拉框 ──────────────────────────────────────────────── */
QComboBox {
    background-color: #FFFFFF;
    border: 1.5px solid #E0E0E0;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    min-width: 120px;
    color: #212529;
}
QComboBox:hover {
    border-color: #0066CC;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    selection-background-color: #E3F2FD;
    selection-color: #0066CC;
    outline: none;
}

/* ── 日期选择 ────────────────────────────────────────────── */
QDateEdit {
    background-color: #FFFFFF;
    border: 1.5px solid #E0E0E0;
    border-radius: 6px;
    padding: 8px 12px;
}
QDateEdit:focus {
    border-color: #0066CC;
}

/* ── 滚动条 ──────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #D0D0D0;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #B0B0B0;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}
QScrollBar:horizontal {
    background: transparent;
    height: 6px;
}
QScrollBar::handle:horizontal {
    background: #D0D0D0;
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #B0B0B0;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    width: 0;
    background: transparent;
}

/* ── 对话框 ──────────────────────────────────────────────── */
QDialog {
    background-color: #F8F9FA;
}
QGroupBox {
    border: 1px solid #E0E0E0;
    border-radius: 10px;
    margin-top: 18px;
    padding-top: 26px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    font-weight: bold;
    color: #212529;
    font-size: 15px;
    background-color: #FFFFFF;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    margin-left: 10px;
    color: #0066CC;
    font-size: 15px;
}

/* ── 标签 ────────────────────────────────────────────────── */
QLabel {
    color: #212529;
    background-color: transparent;
}

/* ── 文件选择标签 ────────────────────────────────────────── */
#FileLabelDefault {
    color: #999999;
    padding: 8px;
    font-size: 13px;
}
#FileLabelSelected {
    color: #212529;
    padding: 8px;
    font-weight: bold;
    font-size: 13px;
}

/* ── 文号识别按钮 ────────────────────────────────────────── */
#ExtractBtn {
    background: rgba(0,102,204,0.06);
    color: #0066CC;
    border: 1px solid rgba(0,102,204,0.15);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
}
#ExtractBtn:hover {
    background: rgba(0,102,204,0.12);
}

/* ── 识别提示 ────────────────────────────────────────────── */
#ExtractHint {
    font-size: 11px;
}

/* ── 卡片控件 ────────────────────────────────────────────── */
#DocumentCard {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 10px;
    padding: 16px;
}
#DocumentCard:hover {
    border-color: #0066CC;
    background-color: #FAFCFF;
}
#CardTitle {
    font-size: 14px;
    font-weight: bold;
    color: #212529;
}
#CardDocNo {
    color: #0066CC;
    font-size: 11px;
}
#CardStatus {
    font-size: 11px;
    font-weight: bold;
}
#CardFileType {
    color: #999999;
    font-size: 11px;
}

/* ── 状态栏 ──────────────────────────────────────────────── */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E0E0E0;
    color: #666666;
    font-size: 12px;
    padding: 4px 12px;
}

/* ── 选项卡 ──────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    background-color: #FFFFFF;
}
QTabBar::tab {
    background-color: #F8F9FA;
    color: #666666;
    border: 1px solid #E0E0E0;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 20px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #0066CC;
    font-weight: bold;
    border-bottom: 2px solid #0066CC;
}

/* ── 统计面板 ────────────────────────────────────────────── */
#StatsTitle {
    font-size: 18px;
    font-weight: bold;
    color: #212529;
}
#StatsCard {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    padding: 20px;
}
#StatsCardIcon {
    font-size: 24px;
    background: transparent;
}
#StatsCardValue {
    font-size: 28px;
    font-weight: bold;
    background: transparent;
}
#StatsCardLabel {
    font-size: 13px;
    background: transparent;
}

/* ── Toast 提示 ──────────────────────────────────────────── */
#Toast {
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: bold;
}

/* ── 进度条 ──────────────────────────────────────────────── */
QProgressBar {
    background-color: #F0F0F0;
    border-radius: 6px;
    text-align: center;
    font-size: 11px;
    color: #212529;
    max-height: 12px;
}
QProgressBar::chunk {
    background-color: #0066CC;
    border-radius: 6px;
}

/* ── 提示框 ──────────────────────────────────────────────── */
QToolTip {
    background-color: #212529;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
}

/* ── 日历 ────────────────────────────────────────────────── */
QCalendarWidget {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 10px;
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #0066CC;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 6px;
    min-height: 44px;
}
QCalendarWidget QToolButton {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: bold;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    margin: 0 2px;
}
QCalendarWidget QToolButton:hover {
    background-color: rgba(255,255,255,0.15);
}
QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    font-size: 16px;
    background-color: rgba(255,255,255,0.15);
    border-radius: 6px;
    padding: 4px 10px;
    min-width: 32px;
    min-height: 32px;
}
QCalendarWidget QSpinBox {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 14px;
}
QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    selection-background-color: #0066CC;
    selection-color: #FFFFFF;
    border: none;
    outline: none;
    font-size: 14px;
}
QCalendarWidget QAbstractItemView:item {
    padding: 6px;
    min-width: 36px;
    min-height: 36px;
}
QCalendarWidget QAbstractItemView QHeaderView::section {
    background-color: #F8F9FA;
    color: #666666;
    font-size: 13px;
    font-weight: bold;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #E0E0E0;
}
QCalendarWidget QAbstractItemView:item:selected {
    background-color: #0066CC;
    color: #FFFFFF;
    border-radius: 4px;
    font-weight: bold;
}

/* ── 表单标签 ────────────────────────────────────────────── */
#FormLabel {
    color: #444444;
    font-size: 13px;
    font-weight: 600;
}
#FormLabelRequired {
    color: #DC3545;
    font-size: 13px;
    font-weight: 600;
}
