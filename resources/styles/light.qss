/* ============================================================
   制度汇编管理系统 — 浅色现代企业级主题（唯一样式入口）
   色板：Primary=#4F46E5  Accent=#6366F1  Success=#10B981  Danger=#EF4444
   所有样式集中于此文件，禁止在其他 .py 文件中使用 setStyleSheet()
   ============================================================ */

/* ── 全局 ────────────────────────────────────────────────── */
* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI Variable",
                 "Segoe UI", "SimHei", sans-serif;
    font-size: 14px;
    color: #212529;
}

QMainWindow {
    background-color: #F8F9FA;
}

/* ── 超链接 ──────────────────────────────────────────────── */
a {
    color: #4F46E5;
}
a:hover {
    color: #6366F1;
    text-decoration: underline;
}
a:visited {
    color: #7C3AED;
}
a.missing-link {
    color: #9CA3AF;
}
a.missing-link:hover {
    color: #6B7280;
}

/* ── 菜单栏 ──────────────────────────────────────────────── */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
    padding: 2px 8px;
}
QMenuBar::item {
    padding: 6px 14px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #EEF2FF;
    color: #4F46E5;
}
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    padding: 8px 36px 8px 16px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #EEF2FF;
    color: #4F46E5;
}
QMenu::separator {
    height: 1px;
    background-color: #F0F0F0;
    margin: 4px 8px;
}

/* ── 工具栏（主窗口自定义）────────────────────────────────── */
#MainWindowToolbar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E8E8E8;
}
#ToolbarBtn {
    background-color: transparent;
    color: #4F46E5;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 500;
}
#ToolbarBtn:hover {
    background-color: #EEF2FF;
    border-color: #C7D2FE;
}
#ToolbarBtn:pressed {
    background-color: #E0E7FF;
}
#ToolbarSep {
    color: #E0E0E0;
    margin: 2px 4px;
}

/* ── 工具栏（旧 QToolBar 兼容）────────────────────────────── */
QToolBar {
    background-color: transparent;
    border: none;
    padding: 0px;
    spacing: 0px;
}
QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 14px;
    color: #212529;
}
QToolBar QToolButton:hover {
    background-color: #EEF2FF;
    color: #4F46E5;
}
QToolBar QToolButton:pressed {
    background-color: #E0E7FF;
}

/* ── 侧边栏 ──────────────────────────────────────────────── */
#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E0E0E0;
}
#SidebarTitle {
    color: #4F46E5;
    font-size: 17px;
    font-weight: bold;
    padding: 16px 16px 2px 16px;
}
#SidebarSubtitle {
    color: #999999;
    font-size: 12px;
    padding: 0px 16px 12px 16px;
}
#Sidebar QPushButton {
    background-color: transparent;
    color: #666666;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    padding: 11px 16px;
    text-align: left;
    font-size: 14px;
    min-height: 20px;
}
#Sidebar QPushButton:hover {
    background-color: #F5F7FA;
    color: #212529;
}
#Sidebar QPushButton:checked,
#Sidebar QPushButton[active="true"] {
    background-color: #EEF2FF;
    color: #4F46E5;
    border-left: 3px solid #4F46E5;
    font-weight: bold;
}
#Sidebar QTreeWidget,
#Sidebar QTreeView {
    background-color: transparent;
    color: #212529;
    border: none;
    outline: none;
    font-size: 14px;
}
#Sidebar QTreeWidget::item,
#Sidebar QTreeView::item {
    padding: 8px 8px;
    border-radius: 6px;
    margin: 1px 4px;
}
#Sidebar QTreeWidget::item:hover,
#Sidebar QTreeView::item:hover {
    background-color: #F0F2F5;
}
#Sidebar QTreeWidget::item:selected,
#Sidebar QTreeView::item:selected {
    background-color: #EEF2FF;
    color: #4F46E5;
    font-weight: bold;
}
#Sidebar QTreeWidget::branch {
    background-color: transparent;
}
#SidebarSeparator {
    background-color: #F0F0F0;
    max-height: 1px;
}
/* 侧边栏分类标签 */
#SidebarCatLabel {
    color: #4F46E5;
    font-size: 16px;
    font-weight: bold;
    padding: 12px 16px 4px 16px;
}
/* 侧边栏统计文字 */
#SidebarStats {
    color: #6B7280;
    font-size: 12px;
    padding: 0px 4px;
}
/* 侧边栏添加分类按钮 */
#SidebarAddCatBtn {
    background: transparent;
    color: #4F46E5;
    border: 1.5px dashed #C7D2FE;
    border-radius: 8px;
    padding: 8px 16px;
    text-align: center;
    font-size: 13px;
}
#SidebarAddCatBtn:hover {
    background-color: #EEF2FF;
    border-color: #4F46E5;
}

/* ── 搜索栏 ──────────────────────────────────────────────── */
#SearchBar {
    background-color: #FFFFFF;
    border: 1.5px solid #E0E0E0;
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 13px;
    color: #212529;
}
#SearchBar:focus {
    border-color: #4F46E5;
}
#SearchBar::placeholder {
    color: #AAAAAA;
}
/* 搜索栏容器 */
#SearchBarContainer {
    background: #FFFFFF;
    border-bottom: 1px solid #E8E8E8;
}

/* ── 面板工具栏 ──────────────────────────────────────────── */
#PanelToolbar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E8E8E8;
    padding: 6px 16px;
}
#PanelTitle {
    font-size: 15px;
    font-weight: bold;
    color: #212529;
}
#PanelCount {
    color: #999999;
    font-size: 12px;
    margin-left: 8px;
}
#PanelSortLabel {
    color: #666666;
    font-size: 12px;
}
#PanelSep {
    color: #E0E0E0;
    margin: 0 4px;
}

/* ── 排序按钮 ────────────────────────────────────────────── */
#SortBtnActive {
    background: #EEF2FF;
    color: #4F46E5;
    border: 1px solid #C7D2FE;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: bold;
}
#SortBtnInactive {
    background: transparent;
    color: #999999;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
}
#SortBtnInactive:hover {
    background: #F5F7FA;
    color: #212529;
}

/* ── 视图切换按钮 ────────────────────────────────────────── */
#ViewBtnActive {
    background: #4F46E5;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 14px;
}
#ViewBtnInactive {
    background: #F8F9FA;
    color: #999999;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    font-size: 14px;
}
#ViewBtnInactive:hover {
    background: #EEF0F2;
    color: #212529;
}

/* ── 批量操作按钮 ────────────────────────────────────────── */
#BatchDeleteBtn {
    background: rgba(239,68,68,0.06);
    color: #EF4444;
    border: 1px solid rgba(239,68,68,0.15);
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: bold;
}
#BatchDeleteBtn:hover {
    background: rgba(239,68,68,0.12);
}
#BatchRestoreBtn {
    background: rgba(16,185,129,0.06);
    color: #10B981;
    border: 1px solid rgba(16,185,129,0.15);
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: bold;
}
#BatchRestoreBtn:hover {
    background: rgba(16,185,129,0.12);
}
#BatchPermanentBtn {
    background: #EF4444;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 4px 14px;
    font-size: 12px;
    font-weight: bold;
}
#BatchPermanentBtn:hover {
    background: #DC2626;
}

/* ── 选中计数 ────────────────────────────────────────────── */
#SelectedCount {
    color: #4F46E5;
    font-size: 12px;
    font-weight: bold;
}

/* ── 单删按钮 ────────────────────────────────────────────── */
#DeleteBtn {
    background: transparent;
    color: #EF4444;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
}
#DeleteBtn:hover {
    background: rgba(239,68,68,0.06);
    border-color: #EF4444;
}

/* ── 全选栏 ──────────────────────────────────────────────── */
#SelectAllBar {
    background: #F8F9FA;
    border-bottom: 1px solid #E0E0E0;
}
#SelectAllCheckbox {
    font-size: 12px;
    color: #666666;
}

/* ── 分页 ────────────────────────────────────────────────── */
#PageBtn {
    background: #FFFFFF;
    color: #666666;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
}
#PageBtn:hover {
    background: #F5F7FA;
}
#PageLabel {
    color: #999999;
    font-size: 12px;
}

/* ── 表格 ────────────────────────────────────────────────── */
QTableWidget, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    gridline-color: #F0F0F0;
    selection-background-color: #EEF2FF;
    selection-color: #4F46E5;
    font-size: 14px;
    outline: none;
}
QTableWidget::item, QTableView::item {
    padding: 6px 12px;
    border-bottom: 1px solid #F0F0F0;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: #EEF2FF;
    color: #4F46E5;
}
QHeaderView::section {
    background-color: #FAFBFC;
    color: #666666;
    font-weight: bold;
    font-size: 14px;
    border: none;
    border-bottom: 2px solid #E0E0E0;
    border-right: 1px solid #F0F0F0;
    padding: 10px 12px;
}
QHeaderView::section:hover {
    background-color: #F0F4F8;
    color: #4F46E5;
}
/* 表格内复选框 */
QTableWidget QCheckBox {
    spacing: 0px;
}
QTableWidget QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

/* ── 编辑按钮（表格内）─────────────────────────────────────── */
#TableEditBtn {
    background: rgba(0,102,204,0.06);
    color: #4F46E5;
    border: 1px solid rgba(0,102,204,0.15);
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 12px;
}
#TableEditBtn:hover {
    background: rgba(0,102,204,0.12);
}

/* ── 按钮 ────────────────────────────────────────────────── */
QPushButton {
    background-color: #4F46E5;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #4338CA;
}
QPushButton:pressed {
    background-color: #3730A3;
}
QPushButton:disabled {
    background-color: #CCCCCC;
    color: #888888;
}

/* ── 次要按钮 ────────────────────────────────────────────── */
#DialogBtnSecondary {
    background-color: #F8F9FA;
    color: #212529;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: normal;
}
#DialogBtnSecondary:hover {
    background-color: #EEF0F2;
    border-color: #CCCCCC;
}

/* ── 输入框 ──────────────────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1.5px solid #E0E0E0;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    color: #212529;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #4F46E5;
}

/* ── 下拉框 ──────────────────────────────────────────────── */
QComboBox {
    background-color: #FFFFFF;
    border: 1.5px solid #E0E0E0;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    min-width: 120px;
    color: #212529;
}
QComboBox:hover {
    border-color: #4F46E5;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    selection-background-color: #EEF2FF;
    selection-color: #4F46E5;
    outline: none;
}

/* ── 日期选择 ────────────────────────────────────────────── */
QDateEdit {
    background-color: #FFFFFF;
    border: 1.5px solid #E0E0E0;
    border-radius: 6px;
    padding: 8px 12px;
}
QDateEdit:focus {
    border-color: #4F46E5;
}

/* ── 滚动条 ──────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #D0D0D0;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #B0B0B0;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}
QScrollBar:horizontal {
    background: transparent;
    height: 6px;
}
QScrollBar::handle:horizontal {
    background: #D0D0D0;
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #B0B0B0;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    width: 0;
    background: transparent;
}

/* ── 对话框 ──────────────────────────────────────────────── */
QDialog {
    background-color: #F8F9FA;
}
QGroupBox {
    border: 1px solid #E0E0E0;
    border-radius: 10px;
    margin-top: 18px;
    padding-top: 26px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    font-weight: bold;
    color: #212529;
    font-size: 15px;
    background-color: #FFFFFF;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    margin-left: 10px;
    color: #4F46E5;
    font-size: 15px;
}

/* ── 标签 ────────────────────────────────────────────────── */
QLabel {
    color: #212529;
    background-color: transparent;
}

/* ── 文件选择标签 ────────────────────────────────────────── */
#FileLabelDefault {
    color: #999999;
    padding: 8px;
    font-size: 13px;
}
#FileLabelSelected {
    color: #212529;
    padding: 8px;
    font-weight: bold;
    font-size: 13px;
}

/* ── 文号识别按钮 ────────────────────────────────────────── */
#ExtractBtn {
    background: rgba(0,102,204,0.06);
    color: #4F46E5;
    border: 1px solid rgba(0,102,204,0.15);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
}
#ExtractBtn:hover {
    background: rgba(0,102,204,0.12);
}

/* ── 识别提示 ────────────────────────────────────────────── */
#ExtractHint {
    font-size: 11px;
}

/* ── 卡片控件 ────────────────────────────────────────────── */
#DocumentCard {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 10px;
    padding: 16px;
}
#DocumentCard:hover {
    border-color: #4F46E5;
    background-color: #FAFCFF;
}
#CardTitle {
    font-size: 14px;
    font-weight: bold;
    color: #212529;
}
#CardDocNo {
    color: #4F46E5;
    font-size: 11px;
}
#CardStatus {
    font-size: 11px;
    font-weight: bold;
}
#CardFileType {
    color: #999999;
    font-size: 11px;
}

/* ── 状态栏 ──────────────────────────────────────────────── */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E0E0E0;
    color: #666666;
    font-size: 12px;
    padding: 4px 12px;
}

/* ── 选项卡 ──────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    background-color: #FFFFFF;
}
QTabBar::tab {
    background-color: #F8F9FA;
    color: #666666;
    border: 1px solid #E0E0E0;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 20px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #4F46E5;
    font-weight: bold;
    border-bottom: 2px solid #4F46E5;
}

/* ── 统计面板 ────────────────────────────────────────────── */
#StatsPanelTitle {
    font-size: 22px;
    font-weight: bold;
    color: #111827;
}
#StatsPanelSubtitle {
    font-size: 13px;
    color: #9CA3AF;
}

/* 各色统计卡片 — 蓝 / 绿 / 橙 / 紫，色相差异明显 */
#StatsCardPrimary {
    background-color: #DBEAFE;
    border: 1px solid #93C5FD;
    border-left: 4px solid #3B82F6;
    border-radius: 12px;
    padding: 20px;
}
#StatsCardSuccess {
    background-color: #D1FAE5;
    border: 1px solid #6EE7B7;
    border-left: 4px solid #10B981;
    border-radius: 12px;
    padding: 20px;
}
#StatsCardIndigo {
    background-color: #FEF3C7;
    border: 1px solid #FCD34D;
    border-left: 4px solid #F59E0B;
    border-radius: 12px;
    padding: 20px;
}
#StatsCardGray {
    background-color: #EDE9FE;
    border: 1px solid #C4B5FD;
    border-left: 4px solid #8B5CF6;
    border-radius: 12px;
    padding: 20px;
}

#StatsCardLabel {
    font-size: 13px;
    font-weight: 600;
    color: #6B7280;
    background: transparent;
}
#StatsCardValue {
    font-size: 36px;
    font-weight: bold;
    color: #111827;
    background: transparent;
}
#StatsCardDesc {
    font-size: 12px;
    color: #9CA3AF;
    background: transparent;
}

#StatsTitle {
    font-size: 18px;
    font-weight: bold;
    color: #212529;
}

/* ── Toast 提示 ──────────────────────────────────────────── */
#Toast {
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: bold;
}

/* ── 进度条 ──────────────────────────────────────────────── */
QProgressBar {
    background-color: #F0F0F0;
    border-radius: 6px;
    text-align: center;
    font-size: 11px;
    color: #212529;
    max-height: 12px;
}
QProgressBar::chunk {
    background-color: #4F46E5;
    border-radius: 6px;
}

/* ── 提示框 ──────────────────────────────────────────────── */
QToolTip {
    background-color: #212529;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
}

/* ── 日历 ────────────────────────────────────────────────── */
QCalendarWidget {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 10px;
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #4F46E5;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 6px;
    min-height: 44px;
}
QCalendarWidget QToolButton {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: bold;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    margin: 0 2px;
}
QCalendarWidget QToolButton:hover {
    background-color: rgba(255,255,255,0.15);
}
QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    font-size: 16px;
    background-color: rgba(255,255,255,0.15);
    border-radius: 6px;
    padding: 4px 10px;
    min-width: 32px;
    min-height: 32px;
}
QCalendarWidget QSpinBox {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 14px;
}
QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
    border: none;
    outline: none;
    font-size: 14px;
}
QCalendarWidget QAbstractItemView:item {
    padding: 6px;
    min-width: 36px;
    min-height: 36px;
}
QCalendarWidget QAbstractItemView QHeaderView::section {
    background-color: #F8F9FA;
    color: #666666;
    font-size: 13px;
    font-weight: bold;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #E0E0E0;
}
QCalendarWidget QAbstractItemView:item:selected {
    background-color: #4F46E5;
    color: #FFFFFF;
    border-radius: 4px;
    font-weight: bold;
}

/* ── 表单标签 ────────────────────────────────────────────── */
#FormLabel {
    color: #444444;
    font-size: 13px;
    font-weight: 600;
}
#FormLabelRequired {
    color: #EF4444;
    font-size: 13px;
    font-weight: 600;
}

/* ── 打分卡面板 (Scorecard Panel) ─────────────────────────── */

/* 打分卡左侧树 */
#ScorecardTree {
    background-color: #FAFBFC;
    border: none;
    border-right: 1px solid #E8E8E8;
    outline: none;
    font-size: 14px;
    color: #212529;
}
#ScorecardTree::item {
    padding: 7px 6px;
    border-radius: 6px;
    margin: 1px 4px;
}
#ScorecardTree::item:hover {
    background-color: #F0F2F5;
}
#ScorecardTree::item:selected {
    background-color: #EEF2FF;
    color: #4F46E5;
    font-weight: bold;
}
#ScorecardTree::branch {
    background-color: transparent;
}
#ScorecardTree::branch:has-children:!selected {
    /* 展开/折叠箭头 */
}
#ScorecardTree::branch:has-children:closed {
    image: none;
}
#ScorecardTree::branch:has-children:open {
    image: none;
}

/* 打分卡搜索结果列表 */
#ScorecardResultList {
    background-color: #FFF8E1;
    border: 1px solid #FFE082;
    border-radius: 8px;
    padding: 4px;
    font-size: 13px;
    color: #5D4037;
}
#ScorecardResultList::item {
    padding: 8px 10px;
    border-radius: 4px;
}
#ScorecardResultList::item:hover {
    background-color: #FFECB3;
}
#ScorecardResultList::item:selected {
    background-color: #FFD54F;
    color: #3E2723;
}

#ScorecardSep {
    color: #E0E0E0;
    margin: 6px 0;
}

#ScorecardSectionLabel {
    font-weight: bold;
    color: #4F46E5;
    font-size: 13px;
    padding-left: 2px;
    margin-top: 8px;
}

#ScorecardDocCard {
    background-color: #F0F7FF;
    border: 1px solid #D0E3F7;
    border-radius: 8px;
    padding: 6px 10px;
}
#ScorecardDocCard:hover {
    border-color: #4F46E5;
    background-color: #E8F0FE;
}

#ScorecardDocTitle {
    font-size: 13px;
    font-weight: bold;
    color: #1E40AF;
    background: transparent;
    border: none;
}

#ScorecardDocMeta {
    font-size: 11px;
    color: #6B7280;
    background: transparent;
    border: none;
}

#ScorecardOpenBtn {
    font-size: 12px;
    padding: 4px 8px;
}

#ScorecardEmptyHint {
    color: #9CA3AF;
    font-size: 12px;
    padding: 8px 12px;
    background-color: #F9FAFB;
    border: 1px dashed #D1D5DB;
    border-radius: 6px;
}

#ScorecardPlaceholder {
    color: #999999;
    font-size: 15px;
    padding: 40px 20px;
    qproperty-alignment: 'AlignCenter';
}

#ScorecardDetailTitle {
    font-size: 18px;
    font-weight: bold;
    color: #111827;
    padding: 8px 0;
    border-bottom: 2px solid #4F46E5;
    margin-bottom: 6px;
}

/* 打分卡右侧详情区背景 */
#ScorecardDetailHost {
    background-color: #F8F9FA;
}

#ScorecardFieldLabel {
    font-weight: bold;
    color: #4F46E5;
    font-size: 13px;
    padding-left: 2px;
    margin-top: 8px;
}

#ScorecardFieldCard {
    background-color: #7bff00;
    border: 1px solid #E5E7EB;
    border-left: 3px solid #6366F1;
    border-radius: 8px;
    padding: 10px 14px;
}

#ScorecardFieldBody {
    color: #212529;
    font-size: 13px;
    background-color: transparent;
    border: none;
}

#ScorecardCiteHeader {
    font-size: 15px;
    font-weight: bold;
    color: #B45309;
    padding: 0;
    background: transparent;
}

#ScorecardCiteRefLabel {
    font-weight: bold;
    color: #495057;
    font-size: 13px;
    background: transparent;
    border: none;
}

#ScorecardCiteRefCard {
    background-color: #FFF7ED;
    border: 1px solid #FED7AA;
    border-radius: 6px;
    padding: 10px 14px;
}

#ScorecardCiteRefContent {
    font-size: 14px;
    color: #92400E;
    font-weight: bold;
    background: transparent;
    border: none;
}

#ScorecardCiteHint {
    color: #6B7280;
    font-size: 12px;
    background-color: #F3F4F6;
    border-radius: 6px;
    padding: 12px 14px;
}

/* ── 侧边栏折叠按钮 ──────────────────────────────────────── */
#SidebarToggleBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #999999;
    font-size: 12px;
    padding: 2px;
}
#SidebarToggleBtn:hover {
    background-color: #F5F7FA;
    color: #4F46E5;
}

/* ── 空状态 ────────────────────────────────────────────────── */
#EmptyStateIcon {
    font-size: 48px;
    background: transparent;
    padding: 16px;
}
#EmptyStateTitle {
    font-size: 18px;
    font-weight: bold;
    color: #6B7280;
    background: transparent;
}
#EmptyStateHint {
    font-size: 13px;
    color: #9CA3AF;
    background: transparent;
    line-height: 1.6;
}

/* ── 设置对话框 ──────────────────────────────────────────── */
#SettingsSizeLabel {
    font-weight: bold;
}
#SettingsTipLabel {
    color: #888888;
    font-size: 12px;
}
